# Copy to .env and set a unique local database password. Never commit .env.
DATABASE_PASSWORD=replace-with-a-unique-local-password
DATABASE_USER=teamflow
DATABASE_NAME=teamflow
APP_ORIGIN=http://localhost:5173
SECURE_COOKIES=false
SPRING_PROFILES_ACTIVE=dev
OPENAPI_ENABLED=true
# Local SMTP mailbox is available at http://localhost:8025 with Compose.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=teamflow@localhost
