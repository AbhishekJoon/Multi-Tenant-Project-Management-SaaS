# Copy to .env.supabase.local; never put real credentials in this example.
# Use the Session pooler (port 5432) from Supabase Dashboard > Connect.
# The JDBC URL contains host/database only: no password or query parameters.
SUPABASE_DB_URL=jdbc:postgresql://your-pooler-host.pooler.supabase.com:5432/postgres
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=replace-with-your-database-password
# Download the CA certificate from Supabase database SSL settings.
SUPABASE_DB_SSL_ROOT_CERT=.secrets/supabase-ca.crt
SUPABASE_DB_POOL_SIZE=5
SUPABASE_DB_MIN_IDLE=1
# Local invitations use Mailpit; authentication emails are sent by Supabase.
APP_ORIGIN=http://localhost:5173
MAIL_FROM=teamflow@localhost
# Supabase Auth: public project origin and publishable (or legacy anon) key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-your-key
